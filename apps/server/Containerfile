FROM docker.io/library/node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/server ./apps/server
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm --filter @mergepad/server... install --frozen-lockfile \
 && pnpm --filter @mergepad/server... build \
 && pnpm --filter @mergepad/server --prod deploy --legacy /out

FROM docker.io/library/node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /out ./
RUN test -f dist/index.js && test -f node_modules/@mergepad/shared/dist/index.js
USER node
EXPOSE 4000
CMD ["node", "dist/index.js"]

{
  "name": "mergepad",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @mergepad/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @mergepad/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @mergepad/server test",
    "test:integration": "pnpm --filter @mergepad/server test:integration",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.58.2",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
